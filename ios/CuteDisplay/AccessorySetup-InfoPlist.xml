<!-- iPhone Home Screen app name. This must be added to the actual app target's Info settings. -->
<key>CFBundleDisplayName</key>
<string>CuteDisplay</string>

<!-- Add these keys to the iPhone app target's existing Info.plist, or in
     Xcode's Target > Info > Custom iOS Target Properties.
     This is a fragment, not a replacement Info.plist. -->
<!-- SDK documentation has used both spellings; keep both for compatibility. -->
<key>NSAccessorySetupKitSupports</key>
<array><string>Bluetooth</string></array>
<key>NSAccessorySetupSupports</key>
<array><string>Bluetooth</string></array>
<key>NSAccessorySetupBluetoothServices</key>
<array><string>FFF0</string></array>
<key>NSAccessorySetupBluetoothNames</key>
<array><string>CuteDisplay</string></array>
<key>NSBluetoothAlwaysUsageDescription</key>
<string>CuteDisplay communicates with your paired drink display over Bluetooth.</string>

<!-- Add to the ACTUAL app target (Target > Signing & Capabilities >
     Background Modes > Uses Bluetooth LE accessories). This is a fragment:
     merge the bluetooth-central string with existing UIBackgroundModes values. -->
<key>UIBackgroundModes</key>
<array><string>bluetooth-central</string></array>

<!-- Required by iOS when connecting to CuteDisplay over the local Wi-Fi network. -->
<key>NSLocalNetworkUsageDescription</key>
<string>Find and control the paired ESP32-S3 Brain over local Wi-Fi when Bluetooth is unavailable.</string>
<key>NSBonjourServices</key>
<array><string>_cutedisplay._tcp</string></array>
